rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email != null && 
              request.auth.token.email.lower() == 'oladoyeheritage445@gmail.com'.lower());
    }

    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function canManageWaitlists(organizationId) {
      let memberPath = /databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid);
      return isSignedIn() && (
        organizationId == request.auth.uid ||
        (exists(memberPath) && (
          get(memberPath).data.role == 'owner' ||
          get(memberPath).data.role == 'admin' ||
          ('permissions' in get(memberPath).data &&
           'manageWaitlists' in get(memberPath).data.permissions &&
           get(memberPath).data.permissions.manageWaitlists == true)
        ))
      );
    }

    // global settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // system activity
    match /system_pulses/{pulseId} {
      allow list, get: if isAdmin();
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // marketing/broadcast templates
    match /email_templates/{templateId} {
      allow list, get: if isAdmin();
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /waitlists/{waitlistId} {
      // Waitlist pages are public; all creation and management remains permission-gated.
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().creatorId == request.auth.uid;
      allow update: if (isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin())) ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalSubscribers', 'updatedAt']) &&
                       request.resource.data.totalSubscribers is number &&
                       request.resource.data.totalSubscribers == resource.data.totalSubscribers + 1);
      allow delete: if isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      match /entries/{entryId} {
        allow create: if incoming().waitlistId == waitlistId &&
                         incoming().email is string &&
                         incoming().email.size() > 0 &&
                         incoming().email.size() <= 256 &&
                         incoming().position is number;
        allow get: if true;
        allow list: if isSignedIn() && 
                       (get(/databases/$(database)/documents/waitlists/$(waitlistId)).data.creatorId == request.auth.uid || isAdmin());
        allow update, delete: if isSignedIn() && 
                                 (get(/databases/$(database)/documents/waitlists/$(waitlistId)).data.creatorId == request.auth.uid || isAdmin());
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (existing().hostId == request.auth.uid || 
                     (existing().coHostIds != null && request.auth.token.email in existing().coHostIds) ||
                     isAdmin());
      allow delete: if isSignedIn() && (existing().hostId == request.auth.uid || isAdmin());

      match /rsvps/{rsvpId} {
        allow read: if true;
        allow create: if true; 
        allow update, delete: if isSignedIn() && (request.auth.uid == rsvpId || isAdmin());
      }
    }
    
    // Support for collection group queries
    match /{path=**}/rsvps/{rsvpId} {
      allow list: if isSignedIn();
    }
  }
}
